# Smart Farming Assistant — environment configuration
# Copy to `.env` and adjust.

# ── Disease model ─────────────────────────────────────────────────────────────
DISEASE_MODEL_CKPT=checkpoints/checkpoint/V8_Full_POWER-ProtoPNet_s42.pth
CLASSES_JSON=classes.json

# Inference device: auto | cpu | cuda | mps
DEVICE=auto

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_MB=20
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///data/farm.db

# ── Weather (OpenWeatherMap) ──────────────────────────────────────────────────
# Get a free key at https://openweathermap.org/api
# Leave WEATHER_API_KEY empty to run on simulated weather data.
WEATHER_API_KEY=
WEATHER_LAT=18.5204
WEATHER_LON=73.8567
WEATHER_LOCATION=Pune, Maharashtra
